  "fixed_sql": [
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"note\" TEXT NULL, \"due_at\" INTEGER NULL, \"due_has_time\" INTEGER NOT NULL DEFAULT 0 CHECK (\"due_has_time\" IN (0, 1)), \"priority\" INTEGER NOT NULL DEFAULT 1, \"reminder_at\" INTEGER NULL, \"reminder_repeat\" INTEGER NOT NULL DEFAULT 0, \"completed_at\" INTEGER NULL, \"snoozed_until\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "log_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"log_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"content\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "setting_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"setting_entries\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "task_reminders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_reminders\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"task_id\" INTEGER NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"offset_minutes\" INTEGER NOT NULL, \"kind\" INTEGER NOT NULL DEFAULT 0, UNIQUE (\"task_id\", \"offset_minutes\"));"
        }
      ]
    },
